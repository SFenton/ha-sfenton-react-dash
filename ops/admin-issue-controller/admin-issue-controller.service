[Unit]
Description=Admin To-Do GitHub issue controller
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/repos/ha-sfenton-react-dash
Environment="PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin"
ExecStart=%h/.local/bin/node %h/.local/share/admin-issue-controller/controller.mjs run %h/.config/admin-issue-controller/controller.json
Restart=on-failure
RestartSec=15s
TimeoutStopSec=45s
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
