# Optional local Fold/Appium test overrides. Copy to .env.emulator and source it before running tests.
# set -a; . .env.emulator; set +a

# Android/Appium host configuration
ANDROID_HOME=
ADB_BIN=
EMULATOR_ADB_DEVICE=
APPIUM_BIN=
EMULATOR_APPIUM_HOST=127.0.0.1
EMULATOR_APPIUM_PORT=4723
EMULATOR_APPIUM_EXTERNAL=0

# Target emulator/app
EMULATOR_DEVICE_NAME=Galaxy_Z_Fold_8
EMULATOR_UDID=
EMULATOR_HA_PACKAGE=io.homeassistant.companion.android
# Activity Appium starts and validates. Override only for another HA app build.
EMULATOR_HA_ACTIVITY=.webview.WebViewActivity
EMULATOR_HA_DASHBOARD_PATH=sfenton-react-dash/home

# Fold profile: WIDTHxHEIGHT and Android device-state IDs
EMULATOR_SIZE_CLOSED=1248x1972
EMULATOR_SIZE_HALF=2448x1848
EMULATOR_SIZE_OPEN=2448x1848
EMULATOR_SIZE_REAR=1248x1972
EMULATOR_STATE_CLOSED=0
EMULATOR_STATE_HALF=1
EMULATOR_STATE_OPEN=2
EMULATOR_STATE_REAR=3
