VITE_HA_URL=http://homeassistant.local:8123
VITE_HA_TOKEN=
VITE_FOLDER_NAME=ha-sfenton-react-dash
VITE_SSH_HOST_KEY_SHA256=
VITE_SSH_HOSTNAME=192.168.1.22
VITE_SSH_PORT=22
VITE_SSH_USERNAME=root
VITE_SSH_PRIVATE_KEY=
VITE_SSH_PASSWORD=
# Server-side Vite proxy target used only in local development when Home
# Assistant has not installed the new EverShelf recipe services.
EVERSHELF_DEV_URL=http://127.0.0.1:8083

HASS_AUTONOMY_EMAIL_ENABLED=true
HASS_AUTONOMY_EMAIL_DRY_RUN=false
HASS_AUTONOMY_EMAIL_FROM=
HASS_AUTONOMY_EMAIL_TO=
HASS_AUTONOMY_EMAIL_SMTP_HOST=smtp.gmail.com
HASS_AUTONOMY_EMAIL_SMTP_PORT=465
HASS_AUTONOMY_EMAIL_SMTP_SECURE=true
HASS_AUTONOMY_EMAIL_SMTP_USER=
HASS_AUTONOMY_EMAIL_SMTP_PASSWORD=
HASS_AUTONOMY_EMAIL_OUTBOX_DIR=.autonomous/outbox
