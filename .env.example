VITE_HA_URL=http://homeassistant.local:8123
VITE_HA_TOKEN=
VITE_FOLDER_NAME=ha-sfenton-react-dash
VITE_SSH_HOST_KEY_SHA256=
VITE_SSH_HOSTNAME=192.168.1.22
VITE_SSH_PORT=22
VITE_SSH_USERNAME=root
VITE_SSH_PRIVATE_KEY=
VITE_SSH_PASSWORD=
# GitHub environment settings used only by the JIT deployment job. The hosted
# Vite build must never receive HA_DEPLOY_TOKEN or HA_DEPLOY_SSH_PRIVATE_KEY.
HA_DEPLOY_URL=http://ha-api-proxy:8123
HA_DEPLOY_TOKEN=
HA_DEPLOY_FOLDER_NAME=ha-sfenton-react-dash
HA_DEPLOY_SSH_HOST=ha-ssh-proxy
HA_DEPLOY_SSH_PORT=2222
HA_DEPLOY_SSH_USERNAME=root
HA_DEPLOY_SSH_PRIVATE_KEY=
HA_DEPLOY_SSH_HOST_KEY_SHA256=
# Server-side Vite proxy target used only in local development when Home
# Assistant has not installed the new EverShelf recipe services.
EVERSHELF_DEV_URL=http://127.0.0.1:8083
# Server-only Home MCP settings. Authenticated clients validate inherited HA
# tokens at runtime; no Home Assistant credential is embedded in the app build.
HOME_MCP_HA_URL=https://homeassistant.sfenton-server.com
HOME_MCP_HOST=127.0.0.1
HOME_MCP_PORT=8787
# For a direct cross-origin browser URL, list the exact dashboard origins.
# Prefer a same-origin reverse proxy and leave this empty.
HOME_MCP_ALLOWED_ORIGINS=
HOME_MCP_DEPLOY_ROOT=
HOME_MCP_TLS_CERT=
HOME_MCP_TLS_KEY=
HOME_MCP_TLS_KEY_SOURCE=/path/to/private/home-mcp-server.key
HOME_MCP_PUBLISH_HEALTH_HOST=

HASS_AUTONOMY_EMAIL_ENABLED=true
HASS_AUTONOMY_EMAIL_DRY_RUN=false
HASS_AUTONOMY_EMAIL_FROM=
HASS_AUTONOMY_EMAIL_TO=
HASS_AUTONOMY_EMAIL_SMTP_HOST=smtp.gmail.com
HASS_AUTONOMY_EMAIL_SMTP_PORT=465
HASS_AUTONOMY_EMAIL_SMTP_SECURE=true
HASS_AUTONOMY_EMAIL_SMTP_USER=
HASS_AUTONOMY_EMAIL_SMTP_PASSWORD=
HASS_AUTONOMY_EMAIL_OUTBOX_DIR=.autonomous/outbox
