{
  "version": 3,
  "project": "ha-react",
  "opportunity": "release",
  "variant": "dashboard-production",
  "enabled": false,
  "operatorAuthorizationRequired": true,
  "reviewer": {
    "role": "medium-review",
    "profile": {
      "model": "gpt-5.6-luna",
      "effort": "medium",
      "context": "default"
    },
    "authority": "review-only"
  },
  "exception": {
    "role": "research-frontier",
    "profile": {
      "model": "gpt-5.6-sol",
      "effort": "high",
      "context": "default"
    },
    "triggerIds": [
      "ha-release-rollback-or-host-conflict"
    ],
    "requiresTriggerReceipt": true
  },
  "steps": [
    {
      "id": "validate-scope",
      "label": "Validate exact patch, changed-test ownership, and prepare the isolated release worktree",
      "executor": "deterministic",
      "operation": "verify",
      "tool": "release-validate-scope",
      "failure": "rejected",
      "evidence": [
        "base revision",
        "scope paths",
        "changed test paths",
        "patch hash",
        "staged diff hash"
      ]
    },
    {
      "id": "validate-change",
      "label": "Run complete dashboard validation",
      "executor": "deterministic",
      "operation": "command",
      "tool": "release-validate-change",
      "failure": "rejected",
      "evidence": [
        "test, lint, build, layout and coverage results"
      ]
    },
    {
      "id": "verify-layout-review",
      "label": "Verify layout and manual review evidence",
      "executor": "deterministic",
      "operation": "verify",
      "tool": "release-verify-layout",
      "failure": "rejected",
      "evidence": [
        "layout assessment",
        "manual image and interaction attestation"
      ]
    },
    {
      "id": "verify-affected-playwright",
      "label": "Run affected Playwright gates with an owned server",
      "executor": "deterministic",
      "operation": "verify",
      "tool": "release-affected-playwright",
      "failure": "rejected",
      "evidence": [
        "affected specs",
        "owned build and server",
        "viewport and state matrix"
      ]
    },
    {
      "id": "create-merge-pr",
      "label": "Create and merge the exact pull request",
      "executor": "deterministic",
      "operation": "git-release",
      "tool": "release-git-driver",
      "failure": "rollback-git",
      "evidence": [
        "branch",
        "commit",
        "pull request",
        "merge commit"
      ]
    },
    {
      "id": "build-merged-master",
      "label": "Build the isolated merged origin/master revision",
      "executor": "deterministic",
      "operation": "command",
      "tool": "release-build-merged",
      "failure": "rollback-git",
      "evidence": [
        "detached origin/master revision",
        "bundle fingerprints"
      ]
    },
    {
      "id": "capture-production",
      "label": "Capture current production assets and host metadata",
      "executor": "deterministic",
      "operation": "verify",
      "tool": "capture-production-disabled",
      "failure": "rollback-git",
      "evidence": [
        "asset backup",
        "legacy wrapper version",
        "panel registration"
      ]
    },
    {
      "id": "deploy-both-hosts",
      "label": "Deploy both Home Assistant hosts",
      "executor": "deterministic",
      "operation": "deploy",
      "tool": "deploy-dashboard-disabled",
      "failure": "rollback-production",
      "evidence": [
        "raw app",
        "legacy wrapper",
        "custom panel",
        "cache-bust version"
      ]
    },
    {
      "id": "verify-production",
      "label": "Verify all production routes and affected behavior",
      "executor": "deterministic",
      "operation": "verify",
      "tool": "verify-production-disabled",
      "failure": "rollback-production",
      "evidence": [
        "three routes",
        "matching bundle",
        "viewport, behavior and restart receipts"
      ]
    },
    {
      "id": "rollback-production",
      "label": "Restore the prior bundle and wrapper version",
      "executor": "deterministic",
      "operation": "rollback",
      "tool": "rollback-dashboard-disabled",
      "rollbackOnly": true,
      "rollbackVerificationTool": "verify-production-rollback-disabled",
      "failure": "abnormal",
      "evidence": [
        "restored bundle",
        "restored wrapper",
        "healthy hosts"
      ]
    },
    {
      "id": "rollback-git",
      "label": "Close the release or create the authorized revert",
      "executor": "deterministic",
      "operation": "rollback",
      "tool": "release-rollback-git",
      "rollbackOnly": true,
      "rollbackVerificationTool": "release-verify-git-rollback",
      "failure": "abnormal",
      "evidence": [
        "closed pull request or revert commit"
      ]
    },
    {
      "id": "cleanup-release",
      "label": "Finalize the production lease and remove exact temporary release artifacts",
      "executor": "deterministic",
      "operation": "cleanup",
      "tool": "release-dashboard-cleanup-disabled",
      "failure": "abnormal",
      "evidence": [
        "released production lease",
        "clean temporary workspace",
        "preserved primary worktree"
      ]
    }
  ]
}
