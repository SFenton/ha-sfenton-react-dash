    },
    {
      "id": "binding-novel-spec-required",
      "category": "specification",
      "description": "Novel evidence must be bound into an implementation-ready specification before known-pattern work starts."
    },
    {
      "id": "consequential-architecture-review",
      "category": "specification",
      "description": "A proposed architecture change crosses established state, lifecycle, hosting, or interaction ownership."
    },
    {
      "id": "ha-physical-action-conflict",
      "category": "critical-review",
      "description": "Primary evidence shows conflicting physical-device outcomes or an unsafe state-to-service mapping."
    },
    {
      "id": "ha-duplicate-side-effect-risk",
      "category": "critical-review",
      "description": "Evidence shows one user intent may issue duplicate or conflicting Home Assistant side effects."
    },
    {
      "id": "ha-credential-exposure-conflict",
      "category": "critical-review",
      "description": "Evidence shows a credential exposure or authentication migration conflict that routine safeguards cannot reconcile."
    },
    {
      "id": "ha-release-rollback-or-host-conflict",
      "category": "critical-review",
      "description": "Release evidence, rollback state, or the two supported Home Assistant hosts disagree."
    },
    {
      "id": "panel-deep-safety-adjudication",
      "category": "critical-review",
      "description": "A deep simulated panel produced a reproduced safety, privacy, or accessibility conflict that material cross-critique did not resolve."
    },
    {
      "id": "panel-material-disagreement-adjudication",
      "category": "critical-review",
      "description": "Primary evidence and cross-vendor panel findings remain materially contradictory after the smallest safe coordinator probe."
    },
    {
      "id": "copy-safety-conflict",
      "category": "critical-review",
      "description": "Deterministic copy gates expose a consequential safety, ownership, placeholder, or notification conflict that routine generation cannot resolve."
    }
  ],
