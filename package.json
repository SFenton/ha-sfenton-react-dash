{
  "name": "ha-sfenton-react-dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/patch-home-assistant-websocket.mjs",
    "postbuild": "node scripts/verify-dashboard-build.mjs",
    "prebuild": "node scripts/patch-home-assistant-websocket.mjs",
    "dev": "vite",
    "home-mcp": "tsx home-mcp/server.ts",
    "home-mcp:check": "tsc -p home-mcp/tsconfig.json",
    "home-mcp:corpus:lights": "tsx home-mcp/corpus/generate-lights.ts",
    "home-mcp:corpus:lights:validate": "tsx home-mcp/corpus/validate-lights.ts",
    "home-mcp:regressions:validate": "tsx home-mcp/improvement/validate-regressions.ts",
    "home-mcp:improvements:worker": "tsx home-mcp/improvement/worker.ts",
    "home-mcp:improvements:install": "tsx home-mcp/improvement/install.ts",
    "home-mcp:improvements:backfill": "tsx scripts/home-mcp-backfill.ts",
    "home-mcp:publish": "tsx home-mcp/improvement/publish.ts",
    "dev:review": "vite --host 0.0.0.0 --port 5176 --strictPort",
    "dev:https": "npm run dev:https:cert && vite --mode https --host 0.0.0.0",
    "dev:https:cert": "tsx scripts/dev-https-cert.ts",
    "dev:mock": "vite --mode test",
    "build": "npm run design:check && npm run i18n:check && npm run home-mcp:check && tsc -b && vite build",
    "build:release": "npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:sync": "tsx scripts/i18n/inventory.ts --write",
    "i18n:check": "tsx scripts/i18n/inventory.ts --check",
    "design:sync": "tsx scripts/design-system/check.ts --write",
    "design:refresh-baseline": "tsx scripts/design-system/check.ts --refresh-baseline",
    "design:check": "tsx scripts/design-system/check.ts --check",
    "check": "npm run test:change-policy && npm run check:ci",
    "check:ci": "npm run test:e2e:coverage && npm run layout:check && npm run test:design && npm run lint && npm run test:run && npm run build",
    "layout:check": "node scripts/layout.mjs check",
    "layout:plan": "node scripts/layout.mjs plan",
    "layout:run": "node scripts/layout.mjs run",
    "layout:verify": "node scripts/layout.mjs verify",
    "layout:review": "node scripts/layout.mjs review",
    "porting:capture": "tsx scripts/hass-porting-capture.ts",
    "email:agent-report": "tsx scripts/agent-report-email.ts",
    "autonomous:admin:audit": "tsx scripts/autonomous-admin.ts audit",
    "autonomous:admin:next": "tsx scripts/autonomous-admin.ts next",
    "autonomous:admin:transition": "tsx scripts/autonomous-admin.ts transition",
    "autonomous:admin:verify-hass": "tsx scripts/autonomous-admin.ts verify-hass",
    "autonomous:admin:sync-descriptions": "tsx scripts/autonomous-admin.ts sync-descriptions",
    "autonomous:admin:email:check": "tsx scripts/agent-report-email.ts --check-config --send --require-send",
    "autonomous:admin:run": "tsx scripts/autonomous-admin-run.ts",
    "admin:issue:bundle": "esbuild scripts/admin-issue-controller.ts --bundle --format=esm --platform=node --target=node22 --outfile=.admin-issue-controller-build/controller.mjs && cp ops/admin-issue-controller/worker-extension.mjs .admin-issue-controller-build/worker-extension.mjs && mkdir -p .admin-issue-controller-build/tandem-research && cp ops/admin-issue-controller/tandem-research/SKILL.md .admin-issue-controller-build/tandem-research/SKILL.md",
    "admin:issue:baseline": "tsx scripts/admin-issue-controller.ts baseline",
    "admin:issue:controller": "tsx scripts/admin-issue-controller.ts run",
    "prepare:hallway-z2m": "tsx scripts/prepare-hallway-z2m-migration.ts",
    "prepare:ios-test-dashboard": "npm run build && tsx scripts/prepare-ios-test-dashboard.ts",
    "sync": "tsx scripts/sync-types.ts",
    "build:deploy": "npm run deploy:both",
    "deploy": "tsx scripts/deploy.ts",
    "deploy:both": "npm run build:release && tsx scripts/deploy.ts --yes",
    "deploy:ci:prepare": "tsx scripts/deploy-dashboard-ci.ts prepare",
    "deploy:runner:bundle": "esbuild scripts/deploy-dashboard-ci.ts --bundle --format=esm --platform=node --target=node22 --external:dotenv --external:home-assistant-js-websocket --external:node-scp --outfile=.ha-deploy-build/deploy-dashboard-ci.mjs && esbuild scripts/ha-deploy-runner-controller.ts --bundle --format=esm --platform=node --target=node22 --outfile=.ha-deploy-build/controller.mjs",
    "deploy:runner:controller": "tsx scripts/ha-deploy-runner-controller.ts run",
    "deploy:ios-test-dashboard": "tsx scripts/deploy-ios-test-dashboard.ts",
    "deploy:sync": "tsx scripts/sync-dashboard-deployment.ts",
    "ha:front-door": "tsx scripts/sync-front-door-unsecured.ts",
    "ha:hot-flash": "tsx scripts/sync-hot-flash-recovery.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:i18n": "vitest run src/i18n scripts/i18n",
    "test:design": "vitest run scripts/design-system",
    "test:change-policy": "tsx scripts/test-change-policy.ts",
    "test:e2e:coverage": "tsx scripts/e2e-coverage-check.ts",
    "test:e2e:responsive": "playwright test e2e/chat-ux.spec.ts e2e/adaptive-navigation.spec.ts e2e/responsive-layout.spec.ts e2e/responsive-pages-all.spec.ts e2e/responsive-modals.spec.ts e2e/responsive-modal-inventory.spec.ts e2e/modal-geometry-stability.spec.ts e2e/modal-rotation-regressions.spec.ts e2e/landscape-modal-adaptation.spec.ts e2e/safe-area-responsive.spec.ts e2e/mobile-device-smoke.spec.ts e2e/feedback-regressions.spec.ts e2e/desktop-responsive.spec.ts e2e/home-route-hydration-desktop.spec.ts e2e/preload-inert.spec.ts",
    "test:e2e": "playwright test",
    "test:e2e:fast": "playwright test --project=mobile",
    "test:e2e:changed": "playwright test --project=mobile --only-changed",
    "test:e2e:mobile-parity": "tsx scripts/required-mobile-parity.ts",
    "test:emulator": "tsx e2e/emulator/run.ts",
    "test:emulator:list": "tsx e2e/emulator/run.ts --list",
    "playwright:mcp:install": "node scripts/playwright-mcp-lifecycle/install.mjs",
    "release:shadow": "tsx scripts/release-machine/shadow.ts",
    "test:release-machine": "vitest run scripts/release-machine",
    "release:driver": "tsx scripts/release-machine/driver.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hakit/components": "^6.0.2",
    "@hakit/core": "^6.0.2",
    "@mdi/js": "^7.4.47",
    "@zxing/browser": "0.1.5",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "hls.js": "1.6.16",
    "home-assistant-js-websocket": "9.6.0",
    "i18next": "^26.3.6",
    "marked": "^18.0.14",
    "motion": "^12.38.0",
    "node-scp": "^0.0.25",
    "nodemailer": "^9.0.3",
    "parse5": "^8.0.1",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.11",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@github/copilot-sdk": "^1.0.13",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.27.7",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.6",
    "webdriverio": "^9.31.7"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
