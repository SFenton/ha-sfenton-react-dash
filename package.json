{
  "name": "ha-sfenton-react-dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "npm run dev:https:cert && vite --mode https --host 0.0.0.0",
    "dev:https:cert": "tsx scripts/dev-https-cert.ts",
    "dev:mock": "vite --mode test",
    "build": "npm run i18n:check && npm run manual:check && tsc -b && vite build",
    "build:release": "npm run manual:check:ha && npm run build",
    "lint": "eslint .",
    "preview": "vite preview",
    "i18n:sync": "tsx scripts/i18n/inventory.ts --write",
    "i18n:check": "tsx scripts/i18n/inventory.ts --check",
    "porting:capture": "tsx scripts/hass-porting-capture.ts",
    "manual:generate": "npm run manual:sync:app && npm run manual:sync:ha",
    "manual:sync:app": "tsx scripts/manual/sync-app.ts",
    "manual:sync:ha": "tsx scripts/manual/sync-ha.ts",
    "manual:sync:mocks": "tsx scripts/manual/sync-mocks.ts",
    "manual:check": "tsx scripts/manual/check.ts",
    "manual:check:ha": "tsx scripts/manual/sync-ha.ts --check",
    "manual:capture": "tsx scripts/manual/runScreenshotSuite.ts --update-snapshots",
    "manual:capture:check": "tsx scripts/manual/runScreenshotSuite.ts && tsx scripts/manual/screenshotReview.ts record-capture-check",
    "manual:screenshots:review": "tsx scripts/manual/contactSheets.ts",
    "manual:screenshots:approve": "tsx scripts/manual/screenshotReview.ts approve",
    "manual:screenshots:check": "tsx scripts/manual/screenshotReview.ts check",
    "manual:lint": "tsx scripts/manual/check.ts",
    "email:agent-report": "tsx scripts/agent-report-email.ts",
    "autonomous:admin:audit": "tsx scripts/autonomous-admin.ts audit",
    "autonomous:admin:next": "tsx scripts/autonomous-admin.ts next",
    "autonomous:admin:transition": "tsx scripts/autonomous-admin.ts transition",
    "autonomous:admin:verify-hass": "tsx scripts/autonomous-admin.ts verify-hass",
    "autonomous:admin:sync-descriptions": "tsx scripts/autonomous-admin.ts sync-descriptions",
    "autonomous:admin:email:check": "tsx scripts/agent-report-email.ts --check-config --send --require-send",
    "autonomous:admin:run": "tsx scripts/autonomous-admin-run.ts",
    "prepare:hallway-z2m": "tsx scripts/prepare-hallway-z2m-migration.ts",
    "sync": "tsx scripts/sync-types.ts",
    "build:deploy": "npm run build:release && npm run deploy",
    "deploy": "tsx scripts/deploy.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:i18n": "vitest run src/i18n scripts/i18n",
    "test:manual": "vitest run src/manual scripts/manual src/pages/AppManualPage.test.tsx src/constants/modalOpeners.test.ts src/constants/routes.test.ts",
    "test:e2e:manual": "playwright test e2e/app-manual.spec.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hakit/components": "^6.0.2",
    "@hakit/core": "^6.0.2",
    "@mdi/js": "^7.4.47",
    "@zxing/browser": "0.1.5",
    "chalk": "^5.6.2",
    "dotenv": "^17.4.2",
    "i18next": "^26.3.6",
    "motion": "^12.38.0",
    "node-scp": "^0.0.25",
    "nodemailer": "^9.0.3",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-i18next": "^17.0.11",
    "tsx": "^4.21.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.6"
  },
  "packageManager": "yarn@4.12.0+sha512.f45ab632439a67f8bc759bf32ead036a1f413287b9042726b7cc4818b7b49e14e9423ba49b18f9e06ea4941c1ad062385b1d8760a8d5091a1a31e5f6219afca8"
}
